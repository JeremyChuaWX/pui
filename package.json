{
  "name": "pui",
  "version": "0.1.0",
  "private": true,
  "description": "An OpenCode-inspired OpenTUI client for Pi",
  "type": "module",
  "bin": {
    "pui": "bin/pui"
  },
  "scripts": {
    "start": "bun --preload @opentui/solid/preload src/index.tsx",
    "test": "bun test src extensions/subagent",
    "typecheck": "tsc --noEmit",
    "check": "bun run typecheck && bun run test",
    "install:local": "./scripts/install-local.sh"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.80.10",
    "@earendil-works/pi-ai": "0.80.10",
    "@earendil-works/pi-coding-agent": "0.80.10",
    "@earendil-works/pi-tui": "0.80.10",
    "@opentui/core": "0.4.5",
    "@opentui/solid": "0.4.5",
    "solid-js": "1.9.12",
    "typebox": "1.1.38"
  },
  "devDependencies": {
    "@types/bun": "1.3.10",
    "@types/node": "24.12.4",
    "typescript": "5.9.3"
  },
  "packageManager": "bun@1.3.14"
}
