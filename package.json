{
    "name": "pui",
    "version": "0.3.0",
    "private": true,
    "description": "An OpenCode-inspired OpenTUI client for Pi",
    "type": "module",
    "scripts": {
        "build": "bun scripts/build.ts",
        "start": "bun --preload @opentui/solid/preload src/index.tsx",
        "test": "bun test src extensions/file-search extensions/subagent extensions/workflow extensions/web",
        "typecheck": "tsc --noEmit",
        "lint": "biome check .",
        "format": "biome format --write .",
        "check": "bun run lint && bun run typecheck && bun run test && bun run build && bun scripts/smoke-build.ts",
        "install": "./scripts/install-local.sh"
    },
    "dependencies": {
        "@earendil-works/pi-agent-core": "0.80.10",
        "@earendil-works/pi-ai": "0.80.10",
        "@earendil-works/pi-coding-agent": "0.80.10",
        "@earendil-works/pi-tui": "0.80.10",
        "@opentui/core": "0.4.5",
        "@opentui/solid": "0.4.5",
        "solid-js": "1.9.12",
        "typebox": "1.1.38"
    },
    "devDependencies": {
        "@biomejs/biome": "2.5.5",
        "@types/bun": "1.3.10",
        "@types/node": "24.12.4",
        "typescript": "5.9.3"
    },
    "packageManager": "bun@1.3.14"
}
