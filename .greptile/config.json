{
    "strictness": 2,
    "commentTypes": ["logic", "syntax"],
    "triggerOnUpdates": true,
    "triggerOnDrafts": false,
    "includeBranches": ["main"],
    "excludeAuthors": ["dependabot[bot]", "renovate[bot]"],
    "ignorePatterns": "*\n!*/\n!*.ts\n!*.tsx\n!*.js\n!*.jsx\n!*.mts\n!*.cts\n!*.mjs\n!*.cjs\n!*.sh\ndist/**\nnode_modules/**",
    "shouldUpdateDescription": false,
    "statusCheck": true,
    "statusCommentsEnabled": true,
    "includeConfidenceScore": true,
    "summarySection": {
        "included": true,
        "collapsible": true,
        "defaultOpen": false
    },
    "issuesTableSection": {
        "included": true,
        "collapsible": false,
        "defaultOpen": true
    }
}
