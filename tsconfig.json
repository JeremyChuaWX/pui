{
    "compilerOptions": {
        "target": "ES2022",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "moduleDetection": "force",
        "jsx": "preserve",
        "jsxImportSource": "@opentui/solid",
        "lib": ["ES2023", "DOM", "DOM.Iterable"],
        "types": ["node", "bun"],
        "strict": true,
        "noEmit": true,
        "allowImportingTsExtensions": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true
    },
    "include": [
        "app/**/*.ts",
        "app/**/*.tsx",
        "extensions/**/*.ts",
        "modules/**/*.ts",
        "pi-core/**/*.ts",
        "shared/**/*.ts",
        "ui/**/*.ts",
        "ui/**/*.tsx"
    ]
}
